{
    "name": "dmstr/api-configuration-bundle",
    "description": "Configurable external API connections: ApiConfiguration entity with type+credentials, health-check + OAuth-authorize flow, ApiExtensionRegistry adapter pattern.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "diemeisterei GmbH",
            "homepage": "https://diemeisterei.de"
        }
    ],
    "require": {
        "php": ">=8.5",
        "symfony/framework-bundle": "^7.0",
        "api-platform/symfony": "^4.0",
        "doctrine/orm": "^3.0",
        "doctrine/doctrine-bundle": "^2.8",
        "dmstr/api-platform-utils-bundle": "*",
        "dmstr/openapi-json-schema-bundle": "*",
        "opis/json-schema": "^2.3",
        "symfony/expression-language": "^7.0|^8.0",
        "symfony/security-bundle": "^7.0|^8.0",
        "symfony/validator": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "doctrine/migrations": "^3.9",
        "doctrine/dbal": "^3.7",
        "ext-pdo_sqlite": "*",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "symfony/browser-kit": "^7.0|^8.0",
        "symfony/http-client": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Dmstr\\ApiConfiguration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmstr\\ApiConfiguration\\Tests\\": "tests/",
            "Dmstr\\ApiConfiguration\\Migrations\\": "migrations/"
        }
    }
}
